{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "release_console",
            "displayName": "GLMJ01 bootstrap launcher",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "LM_BOOTSTRAP": "ON"
            },
            "hidden": false
        },
        {
            "name": "dev_console",
            "displayName": "GLMJ01 bootstrap launcher (development)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "LM_BOOTSTRAP": "ON",
                "LAUNCHER_DEFAULT_SOURCE": "sd"
            },
            "hidden": false
        }
    ],
    "buildPresets": [
        {
            "name": "console",
            "hidden": false,
            "configurePreset": "release_console",
            "targets": [
                "launcher"
            ]
        }
    ]
}
