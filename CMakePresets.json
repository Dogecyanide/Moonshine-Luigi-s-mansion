{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "release_console",
            "displayName": "Release build (Console)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "VERS": "jp;us;pal"
            },
            "hidden": false
        },
        {
            "name": "release_emu",
            "displayName": "Release build (Dolphin)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "IS_EMULATOR": "ON"
            },
            "hidden": false
        },
        {
            "name": "dev_console",
            "displayName": "Dev build (Console)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "ENABLE_DEBUG_WARPS": "ON",
                "ENABLE_SAVESTATE_DBG": "ON",
                "LAUNCHER_DEFAULT_SOURCE": "sd"
            },
            "hidden": false
        },
        {
            "name": "dev_emu",
            "displayName": "Dev build (Emulator)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "IS_EMULATOR": "ON"
            },
            "hidden": false
        }
    ],
    "buildPresets": [
        {
            "name": "console",
            "hidden": false,
            "configurePreset": "release_console",
            "targets": [
                "launcher"
            ]
        },
        {
            "name": "emu_iso",
            "hidden": false,
            "configurePreset": "release_emu",
            "targets": [
                "iso"
            ]
        }
    ]
}
